// biome-ignore-all assist/source/useSortedKeys: order matters in tsconfig files
{
	"$schema": "https://json.schemastore.org/tsconfig",
	// The config the TOOLS pick up: editors, and — via get-tsconfig — the Cypress
	// webpack preprocessor. It exists only to add `baseUrl` on top of
	// `tsconfig.typecheck.json`; every other option lives there.
	//
	// Why the split: `baseUrl` was removed in TypeScript 7 and tsc now errors on
	// it (TS5102), but the preprocessor's tsconfig-paths still needs it to anchor
	// the inherited `paths` at the repo root — without it they resolve relative to
	// `cypress/` and every `@cypress/*` / `@/*` import fails to bundle. So the
	// baseUrl-free variant is what `pnpm typecheck:cypress` reads, and this one is
	// what the bundler reads. Editors may flag the line below — ignore it.
	"extends": ["./tsconfig.typecheck.json"],
	"compilerOptions": {
		"baseUrl": ".."
	}
}
