# ---------------------
# SERVER
# ---------------------
AUTH_BCRYPT_SALT_ROUNDS=10
DATABASE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev_db
NODE_ENV=development
PORT=3000
# Must be at least 32 characters — the session JWT service refuses shorter
# secrets at startup (jose-session-jwt-crypto.service.ts).
SESSION_SECRET=replace-me-with-at-least-32-characters!

# ---------------------
# PUBLIC
# ---------------------
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_NODE_ENV=development
