# === JetBrains AI Assistant / Junie ignore list (.gitignore syntax) ===
# Claude Code does not read this file — its access rules live in .claude/settings.json.
# Keep the env/secret entries of the two files in sync.

# Build output & generated artifacts
.next/
out/
build/
dist/
.turbo/
.cache/
coverage/
*.tsbuildinfo

# Cypress artifacts
cypress/videos/
cypress/screenshots/
cypress/downloads/

# Logs & temp
logs/
*.log
tmp/
temp/

# Env / secrets — .env.example.local is the tracked contract and stays readable
.env*
!.env.example.local

# Deploy
.vercel/

# Stray keys
*.pem
*.key
