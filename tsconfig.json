// biome-ignore-all assist/source/useSortedKeys: order matters in tsconfig files
{
	"$schema": "https://json.schemastore.org/tsconfig",
	// Each base earns its keep (verified via `tsc --showConfig`): strictest =
	// the strictness flags, node-ts = erasableSyntaxOnly/verbatimModuleSyntax,
	// next = lib/module/moduleResolution/jsx plugin. recommended, node-lts, and
	// node24 were dropped 2026-07-30 — every option they set was shadowed by a
	// later base or a local override, so removal is a resolved-config no-op.
	"extends": [
		"@tsconfig/bases/strictest",
		"@tsconfig/bases/node-ts",
		"@tsconfig/bases/next"
	],
	"compilerOptions": {
		// Type Checking Options
		"forceConsistentCasingInFileNames": true, // TS default since 5.0; pinned when the recommended base was dropped
		"exactOptionalPropertyTypes": false, // disabling from strictest base
		"noPropertyAccessFromIndexSignature": false, // disabling from strictest base
		"noUnusedLocals": false, // disabling from strictest base
		// Modules
		"paths": {
			"@/*": ["./src/*"],
			"@cypress/*": ["./cypress/*"],
			"@database/*": ["./database/*"],
			"@devtools/*": ["./devtools/*"],
			"@test-support/*": ["./test-support/*"]
		},
		// Language and Environment
		"types": ["node", "react", "react-dom", "next", "pg"], // TypeScript v6 defaults to [] so I have to set it explicitly
		"jsx": "react-jsx", // deliberate override of the next base's "preserve"; Next accepts both
		"target": "esnext" // Next/SWC handles downleveling; keep source syntax modern
	},
	"include": [
		"next-env.d.ts",
		".next/**/*.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"database/**/*.ts",
		"devtools/**/*.ts",
		"drizzle.config.ts",
		"next.config.ts",
		"test-support/**/*.ts",
		"vitest.config.ts",
		"vitest.setup.ts"
	],
	"exclude": ["dist", "node_modules", "out"]
}
